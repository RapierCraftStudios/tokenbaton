#!/usr/bin/env bash
# Run the official Claude Code CLI under one of N account profiles.
# Each profile (~/.claude-N) keeps its own login; conversations, memory, settings,
# plugins, prompt history and the live-session registry (sessions/, which Claude
# Code uses to find and message other sessions) are symlinked to ~/.claude so
# they are shared, and sessions on different accounts can talk to each other.
#   tokenbaton-profile <N> [claude args...]
set -euo pipefail

COUNT="${TOKENBATON_PROFILES:-5}"
BASE="$HOME/.claude"
ACC="${TOKENBATON_HOME:-$HOME/.tokenbaton}"
STATE="$ACC/current"
SHARED=(projects file-history history.jsonl settings.json CLAUDE.md commands
        agents skills plugins plans keybindings.json)
# Small config files that tools may rewrite in place of the symlink. A rewritten
# copy is folded back into the shared file (newer wins, older kept as backup).
RELINK=(settings.json keybindings.json CLAUDE.md)

n="${1:-}"
if ! [[ "$n" =~ ^[0-9]+$ ]] || (( n < 1 || n > COUNT )); then
  echo "usage: tokenbaton-profile <1-$COUNT> [claude args...]" >&2
  exit 2
fi
shift

relink() {
  local item="$1" src="$2" dst="$3" bk
  bk="$ACC/relink-backup"
  mkdir -p "$bk"
  if ! cmp -s "$src" "$dst"; then
    if [[ "$dst" -nt "$src" ]]; then
      cp -p "$src" "$bk/$item.shared.$(date +%Y%m%d-%H%M%S)"
      cp -p "$dst" "$src"
      echo "tokenbaton-profile: merged newer $dst into shared $src" >&2
    else
      cp -p "$dst" "$bk/$item.claude-$n.$(date +%Y%m%d-%H%M%S)"
      echo "tokenbaton-profile: kept shared $src; older $dst backed up" >&2
    fi
  fi
  ln -sfn "$src" "$dst"
}

# Share the live-session registry: every profile's sessions/ points at
# ~/.claude/sessions. A profile's own folder (from before this) has its records
# moved over first; they're named by pid, so nothing collides. Done for every
# profile, so sessions already running elsewhere become visible too.
share_sessions() {
  local d="$1" f
  [[ -d "$d" && ! -L "$d/sessions" ]] || return 0
  if [[ -d "$d/sessions" ]]; then
    for f in "$d/sessions"/* "$d/sessions"/.[!.]*; do
      [[ -e "$f" ]] && mv -n "$f" "$BASE/sessions/" 2>/dev/null
    done
    rmdir "$d/sessions" 2>/dev/null || return 0   # a record landed meanwhile: next launch
  fi
  ln -s "$BASE/sessions" "$d/sessions" 2>/dev/null || true
}
mkdir -p "$BASE/sessions" && chmod 700 "$BASE/sessions" 2>/dev/null || true
for (( i = 1; i <= COUNT; i++ )); do share_sessions "$HOME/.claude-$i"; done

dir="$HOME/.claude-$n"
mkdir -p "$dir"
share_sessions "$dir"
for item in "${SHARED[@]}"; do
  src="$BASE/$item"
  dst="$dir/$item"
  [[ -e "$src" ]] || continue
  if [[ -L "$dst" ]]; then
    continue
  elif [[ -f "$dst" && " ${RELINK[*]} " == *" $item "* ]]; then
    relink "$item" "$src" "$dst"
  elif [[ -e "$dst" ]]; then
    echo "tokenbaton-profile: $dst exists and is not a symlink; not sharing it" >&2
  else
    ln -s "$src" "$dst"
  fi
done

# The last-used profile is a hint for the next start; failing to save it (full
# disk) must not stop this one.
[[ -n "${TOKENBATON_NO_STATE:-}" ]] || { mkdir -p "$(dirname "$STATE")" && echo "$n" > "$STATE"; } 2>/dev/null || true
echo "tokenbaton-profile: account $n ($dir)" >&2
CLAUDE_CONFIG_DIR="$dir" exec claude "$@"
