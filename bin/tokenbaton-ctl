#!/usr/bin/env python3
"""tokenbaton account management: keepalive, prime, login, status.

Reached through `tokenbaton keepalive|prime|login|status`; never prints a token.

  tokenbaton status
  tokenbaton keepalive [--dry-run] | --install | --uninstall
  tokenbaton prime [--dry-run] | --install | --uninstall
  tokenbaton login <N> | --new [claude auth login args...]
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
ACC = os.environ.get("TOKENBATON_HOME") or os.path.join(HOME, ".tokenbaton")
COUNT = int(os.environ.get("TOKENBATON_PROFILES") or 5)
# A login lasts a fixed time from sign-in (Claude Code stores the earlier of the
# old and new refresh expiry on every refresh, so no refresh can extend it).
# keepalive warns this many hours before a login runs out.
KEEPALIVE_HOURS = float(os.environ.get("TOKENBATON_KEEPALIVE_HOURS") or 72)
# proper-lockfile (what Claude Code uses) treats a lock whose mtime hasn't been
# touched for ~10s as stale; a live holder keeps touching it.
LOCK_SETTLE = float(os.environ.get("TOKENBATON_LOCK_SETTLE") or 15)
LOCK_STALE = float(os.environ.get("TOKENBATON_LOCK_STALE") or 60)
REFRESH_TIMEOUT = float(os.environ.get("TOKENBATON_REFRESH_TIMEOUT") or 90)
SELF = os.path.realpath(__file__)
BIN = os.path.dirname(SELF)
UNIT = "tokenbaton-keepalive"
LOG = os.path.join(ACC, "keepalive.log")
PRIME_UNIT = "tokenbaton-prime"
PRIME_LOG = os.path.join(ACC, "prime.log")
PRIME_MODEL = os.environ.get("TOKENBATON_PRIME_MODEL") or "haiku"
# Short, ordinary questions; one is picked at random each time.
PRIME_PROMPTS = [
    "What's a good one-line description for a git commit that fixes a typo in a README?",
    "Quick one: is it 'log in' or 'login' when it's used as a verb?",
    "What's the difference between `git fetch` and `git pull`, in one sentence?",
    "In one sentence, when would you use a set instead of a list in Python?",
    "What does `set -euo pipefail` do in a bash script? Keep it short.",
    "What would you call a function that checks whether a file is older than a day?",
    "In one line: what's the difference between `==` and `is` in Python?",
    "What's a sensible default timeout for an HTTP health check? Short answer is fine.",
    "Is `chmod 600` right for a file holding credentials? One sentence.",
    "What's the quickest way to see which process is listening on port 8080 on Linux?",
]
# After a window goes idle, wait a random number of minutes in this range
# before priming it, so accounts don't start exactly at their resets.
PRIME_DELAY_MIN = float(os.environ.get("TOKENBATON_PRIME_DELAY_MIN") or 5)
PRIME_DELAY_MAX = float(os.environ.get("TOKENBATON_PRIME_DELAY_MAX") or 45)
PRIME_TIMEOUT = float(os.environ.get("TOKENBATON_PRIME_TIMEOUT") or 120)
USAGE_URL = os.environ.get("TOKENBATON_USAGE_URL") or "https://api.anthropic.com/api/oauth/usage"


# ---------------------------------------------------------------- profiles

def pdir(n):
    return os.path.join(HOME, ".claude-%d" % n)


def profiles():
    """Every existing numeric profile that has a login file."""
    out = set(range(1, COUNT + 1))
    for p in glob.glob(os.path.join(HOME, ".claude-[0-9]*")):
        m = re.fullmatch(r".*/\.claude-(\d+)", p)
        if m and os.path.isdir(p):
            out.add(int(m.group(1)))
    return sorted(out)


def read_oauth(n):
    try:
        with open(os.path.join(pdir(n), ".credentials.json")) as f:
            return json.load(f).get("claudeAiOauth") or {}
    except (OSError, ValueError):
        return {}


def email(n):
    try:
        with open(os.path.join(pdir(n), ".claude.json")) as f:
            return (json.load(f).get("oauthAccount") or {}).get("emailAddress") or "?"
    except (OSError, ValueError):
        return "?"


def identity(n):
    """Who profile n is logged in as: (account, organization), or None. Two
    profiles with the same identity share one usage pool."""
    try:
        with open(os.path.join(pdir(n), ".claude.json")) as f:
            a = json.load(f).get("oauthAccount") or {}
    except (OSError, ValueError):
        return None
    acct = a.get("accountUuid") or (a.get("emailAddress") or "").lower()
    return (acct, a.get("organizationUuid") or "") if acct else None


def duplicate_of(n, lower_only=False):
    """The lowest other profile (only lower-numbered ones with lower_only)
    logged in to the same account as n, or None."""
    me = identity(n)
    if not me:
        return None
    for m in profiles():
        if lower_only and m >= n:
            break
        if m != n and read_oauth(m).get("refreshToken") and identity(m) == me:
            return m
    return None


def secs(ms):
    return ms / 1000.0 if isinstance(ms, (int, float)) and ms > 0 else None


def usable(o, now):
    rexp = secs(o.get("refreshTokenExpiresAt"))
    return bool(o.get("refreshToken")) and (rexp is None or rexp > now)


def rel(t, now):
    """'in 3h12m' / '5h ago' / 'never'."""
    if t is None:
        return "-"
    d = t - now
    a = abs(d)
    if a >= 86400:
        s = "%dd%dh" % (a // 86400, a % 86400 // 3600)
    elif a >= 3600:
        s = "%dh%02dm" % (a // 3600, a % 3600 // 60)
    else:
        s = "%dm" % (a // 60)
    return ("in " + s) if d > 0 else (s + " ago")


def stamp(t):
    return time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime(t)) if t else "-"


def current():
    try:
        return int(open(os.path.join(ACC, "current")).read().strip())
    except (OSError, ValueError):
        return None


# ------------------------------------------------------------------ status

def live(n, now):
    """(5h cell, 7d cell) from live.N. A sample whose window already reset
    shows the sampled figure with '*' and the reset as past: it's stale."""
    try:
        p5, r5, p7, r7, at = map(int, open(os.path.join(ACC, "live.%d" % n)).read().split())
    except (OSError, ValueError):
        return "-", "-"

    def cell(p, r):
        if r <= now:
            return "0%% (was %d%%*)" % p if p else "0% (reset*)"
        return "%d%% %s" % (p, rel(r, now))
    return cell(p5, r5), cell(p7, r7)


def cmd_status(args):
    now = time.time()
    cur = current()
    rows = [("", "N", "EMAIL", "5H", "7D", "ACCESS", "LOGIN ENDS", "USABLE")]
    for n in profiles():
        o = read_oauth(n)
        if not o and not os.path.isdir(pdir(n)):
            continue
        aexp, rexp = secs(o.get("expiresAt")), secs(o.get("refreshTokenExpiresAt"))
        c5, c7 = live(n, now)
        if not o.get("refreshToken") and not (rexp and rexp <= now):
            ok = "no (not logged in: tokenbaton login %d)" % n
        elif usable(o, now):
            d = duplicate_of(n, lower_only=True)
            ok = "yes" if d is None else \
                "no (DUPLICATE of %d, same account: tokenbaton login %d with another)" % (d, n)
        else:
            ok = "no (refresh expired: tokenbaton login %d)" % n
        rows.append(("*" if n == cur else "", str(n), email(n), c5, c7,
                     rel(aexp, now) if o else "-", rel(rexp, now) if o else "-", ok))
    w = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        print("  ".join(c.ljust(w[i]) for i, c in enumerate(r)).rstrip())
    print("\n* = current account; 5H/7D '*' = sample is from before the window reset (stale)")
    return 0


# --------------------------------------------------------------- keepalive

def claude_bin():
    """The real claude: $TOKENBATON_CLAUDE, else claude on PATH minus the
    tokenbaton-exec shim directory (which would pick another account)."""
    if os.environ.get("TOKENBATON_CLAUDE"):
        return os.environ["TOKENBATON_CLAUDE"]
    shim = os.path.join(ACC, "shim")
    path = os.pathsep.join(p for p in os.environ.get("PATH", "").split(os.pathsep)
                           if os.path.realpath(p) != os.path.realpath(shim))
    return shutil.which("claude", path=path) or "claude"


def lock_age(lock):
    try:
        return time.time() - os.stat(lock).st_mtime
    except OSError:
        return None


def renew(n, reason):
    """Let claude refresh profile n by itself. Returns (ok, detail)."""
    d = pdir(n)
    lock = d + ".lock"
    age = lock_age(lock)
    if age is not None:
        if age < LOCK_STALE:
            return None, "busy: refresh lock held %ds, left alone" % age
        try:
            os.rmdir(lock)
        except OSError:
            return None, "busy: stale refresh lock could not be removed"
    before = read_oauth(n)
    env = dict(os.environ, CLAUDE_CONFIG_DIR=d)
    env.pop("ANTHROPIC_API_KEY", None)
    started = time.time()
    try:
        subprocess.run([claude_bin(), "auth", "status", "--json"], env=env,
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=REFRESH_TIMEOUT, cwd=HOME)
    except (OSError, subprocess.TimeoutExpired) as e:
        detail = "claude did not finish (%s)" % type(e).__name__
    else:
        detail = None
    # `claude auth status` can exit without releasing the refresh lock. Its
    # holder is gone, so once the lock has stopped being touched it is stale.
    deadline = time.time() + LOCK_SETTLE + 5
    while time.time() < deadline:
        age = lock_age(lock)
        if age is None:
            break
        if age >= LOCK_SETTLE and os.stat(lock).st_mtime >= started - 1:
            try:
                os.rmdir(lock)
            except OSError:
                pass
            break
        time.sleep(0.5)
    after = read_oauth(n)
    now = time.time()
    aexp = secs(after.get("expiresAt"))
    if aexp and aexp > now + 60 and after.get("refreshToken"):
        b = secs(before.get("refreshTokenExpiresAt"))
        a = secs(after.get("refreshTokenExpiresAt"))
        slid = "refresh expiry %s -> %s" % (stamp(b), stamp(a)) if a != b else \
            "refresh expiry unchanged (%s)" % stamp(a)
        return True, "renewed: access valid until %s, %s" % (stamp(aexp), slid)
    return False, "FAILED: %s" % (detail or "claude ran but the login was not renewed")


def cmd_keepalive(args):
    if "--install" in args:
        return install_timer()
    if "--uninstall" in args:
        return uninstall_timer()
    dry = "--dry-run" in args
    now = time.time()
    thr = KEEPALIVE_HOURS * 3600
    print("tokenbaton keepalive %s%s (renew expired access tokens; warn %gh before a login ends)" % (
        time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)), " [dry-run]" if dry else "",
        KEEPALIVE_HOURS))
    rows, failed, warn = [], False, []
    for n in profiles():
        o = read_oauth(n)
        aexp, rexp = secs(o.get("expiresAt")), secs(o.get("refreshTokenExpiresAt"))
        if not o and not os.path.exists(os.path.join(pdir(n), ".claude.json")):
            continue
        cols = (n, email(n), rel(aexp, now), rel(rexp, now))
        if not o.get("refreshToken") and not (rexp and rexp <= now):
            rows.append(cols + ("not logged in: tokenbaton login %d" % n,))
            continue
        if not usable(o, now):
            warn.append("profile %d (%s) is logged out: tokenbaton login %d" % (n, email(n), n))
            rows.append(cols + ("DEAD: login ended, interactive login needed: "
                                "tokenbaton login %d" % n,))
            continue
        ending = ""
        if rexp is not None and rexp - now < thr:
            warn.append("profile %d (%s) login ends %s: tokenbaton login %d" % (
                n, email(n), rel(rexp, now), n))
            ending = "; LOGIN ENDS %s, a refresh can't extend it: tokenbaton login %d" % (
                rel(rexp, now), n)
        if aexp is not None and aexp > now:
            rows.append(cols + ("ok, no action" + ending,))
            continue
        if dry:
            rows.append(cols + ("would renew (access token expired)" + ending,))
            continue
        ok, detail = renew(n, "access token expired")
        failed |= ok is False
        rows.append(cols + ("%s [access token expired]%s" % (detail, ending),))
    for n, em, a, r, act in rows:
        print("profile %d  %s  access %s  login ends %s  -> %s" % (n, em, a, r, act))
    if warn and not dry:
        notify("tokenbaton: log in again soon", "\n".join(warn))
    return 1 if failed else 0


def notify(title, body):
    """Desktop notification, where one can be shown; the log has it either way."""
    tool = shutil.which("notify-send") or shutil.which("osascript")
    if not tool or os.environ.get("TOKENBATON_NO_NOTIFY"):
        return
    try:
        if tool.endswith("osascript"):
            subprocess.run([tool, "-e", "display notification %s with title %s" % (
                json.dumps(body), json.dumps(title))], timeout=10, capture_output=True)
        else:
            subprocess.run([tool, "-u", "critical", "-a", "tokenbaton", title, body],
                           timeout=10, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass


def trim_log(log=LOG):
    try:
        if os.path.getsize(log) > 1 << 20:
            keep = open(log, "rb").read()[-(256 << 10):]
            open(log, "wb").write(keep)
    except OSError:
        pass


def systemctl(*a):
    return subprocess.run([os.environ.get("TOKENBATON_SYSTEMCTL", "systemctl"), "--user", *a],
                          capture_output=True, text=True)


def unit_dir():
    return os.environ.get("TOKENBATON_UNIT_DIR") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "systemd", "user")


def install_timer(unit=UNIT, cmd="keepalive", log=LOG, desc="renew Claude Code logins before they expire",
                  calendar="*-*-* 00/6:00:00", every="every 6 hours", jitter=300):
    os.makedirs(ACC, exist_ok=True)
    os.makedirs(unit_dir(), exist_ok=True)
    cb = claude_bin()
    cb_path = shutil.which(cb) or cb
    path = os.pathsep.join(dict.fromkeys(
        [p for p in (os.path.dirname(cb_path), os.path.dirname(os.path.realpath(cb_path)),
                     os.path.dirname(shutil.which("node") or ""),
                     *os.environ.get("PATH", "").split(os.pathsep),
                     "/usr/local/bin", "/usr/bin", "/bin") if p]))
    service = """[Unit]
Description=tokenbaton %s: %s

[Service]
Type=oneshot
Environment="PATH=%s"
Environment="TOKENBATON_HOME=%s"
Environment="TOKENBATON_PROFILES=%d"
Environment="TOKENBATON_KEEPALIVE_HOURS=%g"
ExecStartPre=/bin/sh -c 'mkdir -p "%s"'
ExecStart=%s %s
StandardOutput=append:%s
StandardError=append:%s
""" % (cmd, desc, path, ACC, COUNT, KEEPALIVE_HOURS, ACC, SELF, cmd, log, log)
    if PRIME_MODEL != "haiku":
        service = service.replace("[Service]\n", '[Service]\nEnvironment="TOKENBATON_PRIME_MODEL=%s"\n' % PRIME_MODEL)
    timer = """[Unit]
Description=tokenbaton %s %s

[Timer]
OnCalendar=%s
RandomizedDelaySec=%d
Persistent=true

[Install]
WantedBy=timers.target
""" % (cmd, every, calendar, jitter)
    for name, body in ((unit + ".service", service), (unit + ".timer", timer)):
        with open(os.path.join(unit_dir(), name), "w") as f:
            f.write(body)
    r = systemctl("daemon-reload")
    e = systemctl("enable", "--now", unit + ".timer")
    if r.returncode or e.returncode:
        sys.stderr.write("tokenbaton: systemd user timer could not be enabled (%s).\n"
                         "Use cron instead (%s):\n  %s %s >> %s 2>&1\n"
                         % ((r.stderr + e.stderr).strip() or "systemctl failed", every,
                            "0 */6 * * *" if cmd == "keepalive" else "*/5 * * * *", SELF + " " + cmd, log))
        return 1
    print("installed %s.timer (%s, log: %s)" % (unit, every, log))
    print(systemctl("list-timers", unit + ".timer", "--no-pager").stdout.strip())
    return 0


def uninstall_timer(unit=UNIT):
    systemctl("disable", "--now", unit + ".timer")
    for name in (".service", ".timer"):
        try:
            os.unlink(os.path.join(unit_dir(), unit + name))
        except OSError:
            pass
    systemctl("daemon-reload")
    print("removed %s.timer" % unit)
    return 0


# ------------------------------------------------------------------- prime

def iso_epoch(v):
    """'2026-11-17T08:00:00.014+00:00' -> epoch seconds, None if absent."""
    if not v:
        return None
    try:
        from datetime import datetime
        return datetime.fromisoformat(re.sub(r"\.\d+", "", v).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def fetch_usage(n):
    """The usage endpoint's five_hour/seven_day for profile n, or (None, why)."""
    import urllib.request
    import urllib.error
    tok = read_oauth(n).get("accessToken")
    if not tok:
        return None, "no access token"
    req = urllib.request.Request(USAGE_URL.replace("{n}", str(n)), headers={
        "Authorization": "Bearer " + tok, "anthropic-beta": "oauth-2025-04-20"})
    try:
        d = json.load(urllib.request.urlopen(req, timeout=15))
    except urllib.error.HTTPError as e:
        return None, "usage endpoint HTTP %d" % e.code
    except (OSError, ValueError) as e:
        return None, "usage endpoint unreachable (%s)" % type(e).__name__
    out = {}
    for k in ("five_hour", "seven_day"):
        w = d.get(k) or {}
        out[k] = (round(w.get("utilization") or 0), iso_epoch(w.get("resets_at")))
    return out, None


def save_live(n, u):
    """Record the endpoint's figures where status and the switcher read them."""
    (p5, r5), (p7, r7) = u["five_hour"], u["seven_day"]
    path = os.path.join(ACC, "live.%d" % n)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        with open(tmp, "w") as f:
            f.write("%d %d %d %d %d\n" % (p5, r5 or 0, p7, r7 or 0, time.time()))
        os.replace(tmp, path)
    except OSError:
        pass


def send_prime(n):
    """One short, ordinary question on profile n: no tools, no MCP, no saved session."""
    import random
    prompt = os.environ.get("TOKENBATON_PRIME_PROMPT") or random.choice(PRIME_PROMPTS)
    env = dict(os.environ, CLAUDE_CONFIG_DIR=pdir(n), TOKENBATON_NO_STATE="1")
    env.pop("ANTHROPIC_API_KEY", None)
    try:
        r = subprocess.run([claude_bin(), "-p", prompt, "--model", PRIME_MODEL,
                            "--tools", "", "--strict-mcp-config", "--no-session-persistence"],
                           env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=PRIME_TIMEOUT, cwd=tempfile.gettempdir())
    except (OSError, subprocess.TimeoutExpired) as e:
        return "claude did not finish (%s)" % type(e).__name__
    if r.returncode:
        msg = (r.stderr or r.stdout).strip().splitlines()
        return "claude exited %d%s" % (r.returncode, (": " + msg[-1][:120]) if msg else "")
    return None


def prime_due(n, now, dry):
    """When profile n's idle window should be primed (epoch s). The first run
    that sees it idle picks a random delay and saves it in prime.N, so later
    runs keep the same moment; a dry run only reads it."""
    path = os.path.join(ACC, "prime.%d" % n)
    try:
        return float(open(path).read().split()[0])
    except (OSError, ValueError, IndexError):
        pass
    import random
    lo, hi = sorted((max(PRIME_DELAY_MIN, 0), max(PRIME_DELAY_MAX, 0)))
    due = now + random.uniform(lo, hi) * 60
    if not dry:
        try:
            with open(path, "w") as f:
                f.write("%d\n" % due)
        except OSError:
            pass
    return due


def prime_clear(n):
    try:
        os.unlink(os.path.join(ACC, "prime.%d" % n))
    except OSError:
        pass


def cmd_prime(args):
    """Start every idle usage window: an account whose 5-hour or weekly window
    isn't running (the endpoint gives it no reset time) gets one tiny message,
    so its clock starts now instead of whenever it is next used."""
    if "--install" in args:
        return install_timer(PRIME_UNIT, "prime", PRIME_LOG,
                             "start idle usage windows so their reset clocks run",
                             "*:00/5", "every 5 minutes", 120)
    if "--uninstall" in args:
        return uninstall_timer(PRIME_UNIT)
    dry = "--dry-run" in args
    now = time.time()
    print("tokenbaton prime %s%s" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
                                     " [dry-run]" if dry else ""))
    failed = False
    names = {"five_hour": "5h", "seven_day": "7d"}

    def show(u):
        return "  ".join("%s %d%% %s" % (names[k], u[k][0], rel(u[k][1], time.time()) if u[k][1]
                                         else "idle") for k in names)
    for n in profiles():
        o = read_oauth(n)
        if not o:
            continue
        head = "profile %d  %s" % (n, email(n))
        if not usable(o, now):
            print("%s  -> skipped: not logged in (tokenbaton login %d)" % (head, n))
            continue
        aexp = secs(o.get("expiresAt"))
        if (aexp is None or aexp <= now + 60) and not dry:
            ok, detail = renew(n, "access token expired")
            if not ok:
                failed |= ok is False
                print("%s  -> skipped: %s" % (head, detail))
                continue
        u, why = fetch_usage(n)
        if u is None:
            print("%s  -> skipped: %s" % (head, why))
            continue
        idle = [names[k] for k in names if u[k][1] is None]
        if not idle:
            save_live(n, u)
            prime_clear(n)
            print("%s  %s  -> ok, windows running" % (head, show(u)))
            continue
        due = prime_due(n, now, dry)
        if due > time.time():
            print("%s  %s  -> %s idle; primes %s" % (head, show(u), "+".join(idle),
                                                    rel(due, time.time())))
            continue
        if dry:
            print("%s  %s  -> would prime (%s idle)" % (head, show(u), "+".join(idle)))
            continue
        err = send_prime(n)
        prime_clear(n)
        if err:
            failed = True
            print("%s  %s  -> FAILED to prime: %s" % (head, show(u), err))
            continue
        after = None
        for _ in range(3):
            time.sleep(5)
            after, _why = fetch_usage(n)
            if after and all(after[k][1] for k in names):
                break
        if after:
            save_live(n, after)
            print("%s  -> primed (%s idle); now %s" % (head, "+".join(idle), show(after)))
        else:
            print("%s  -> primed (%s idle); new reset times not read yet" % (head, "+".join(idle)))
    return 1 if failed else 0


# ------------------------------------------------------------------- login

def next_free():
    n = 1
    while os.path.exists(os.path.join(pdir(n), ".credentials.json")):
        n += 1
    return n


def restore_login(n, saved):
    """Put profile n's login files back to the bytes saved before a login
    (removing a login file that didn't exist before), keeping 0600."""
    for name, data in saved.items():
        path = os.path.join(pdir(n), name)
        if data is None:
            if name == ".credentials.json":
                try:
                    os.unlink(path)
                except OSError:
                    pass
            continue
        real = os.path.realpath(path)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(real), prefix=name + ".", suffix=".tmp")
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(data)
            os.chmod(tmp, 0o600)
            os.replace(tmp, real)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)


def cmd_login(args):
    if not args or args[0] in ("-h", "--help"):
        print("usage: tokenbaton login <N> | --new [--email ADDR] [--sso] [--console]")
        return 2
    if args[0] == "--new":
        n = next_free()
        print("tokenbaton: next free profile is %d (%s)" % (n, pdir(n)))
        if n > COUNT:
            print("tokenbaton: set TOKENBATON_PROFILES=%d so it joins the rotation" % n)
    elif args[0].isdigit() and int(args[0]) >= 1:
        n = int(args[0])
    else:
        print("usage: tokenbaton login <N> | --new", file=sys.stderr)
        return 2
    extra = args[1:]
    before = read_oauth(n)
    saved = {}
    for name in (".credentials.json", ".claude.json"):
        try:
            with open(os.path.join(pdir(n), name), "rb") as f:
                saved[name] = f.read()
        except OSError:
            saved[name] = None
    env = dict(os.environ, TOKENBATON_NO_STATE="1")
    env.pop("CLAUDE_CONFIG_DIR", None)
    env["PATH"] = os.pathsep.join(
        p for p in env.get("PATH", "").split(os.pathsep)
        if os.path.realpath(p) != os.path.realpath(os.path.join(ACC, "shim")))
    rc = subprocess.call([os.path.join(BIN, "tokenbaton-profile"), str(n), "auth", "login", *extra],
                         env=env)
    o = read_oauth(n)
    if rc != 0 or not o.get("refreshToken"):
        print("tokenbaton: login for profile %d did not complete (claude exit %d)" % (n, rc),
              file=sys.stderr)
        return 1
    dup = duplicate_of(n)
    if dup is not None:
        who = email(n)
        restore_login(n, saved)
        print("tokenbaton: rejected: %s is already logged in on profile %d; each profile must be "
              "a different account (they would share one usage pool). Profile %d was %s." % (
                  who, dup, n, "put back as it was" if saved[".credentials.json"] else "left logged out"),
              file=sys.stderr)
        return 1
    if o == before:
        print("tokenbaton: warning: profile %d credentials are unchanged" % n, file=sys.stderr)
    now = time.time()
    print("tokenbaton: profile %d logged in as %s; access %s, refresh %s" % (
        n, email(n), rel(secs(o.get("expiresAt")), now), rel(secs(o.get("refreshTokenExpiresAt")), now)))
    return 0


def main(argv):
    cmd, args = (argv[1], argv[2:]) if len(argv) > 1 else ("", [])
    fn = {"status": cmd_status, "keepalive": cmd_keepalive, "prime": cmd_prime,
          "login": cmd_login}.get(cmd)
    if not fn:
        print(__doc__, file=sys.stderr)
        return 2
    if cmd in ("keepalive", "prime") and not ({"--dry-run", "--install", "--uninstall"} & set(args)):
        os.makedirs(ACC, exist_ok=True)
        trim_log(LOG if cmd == "keepalive" else PRIME_LOG)
    return fn(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
