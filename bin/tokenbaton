#!/usr/bin/env bash
# tokenbaton: run Claude Code and, whenever it exits, offer to resume the
# conversation this window was last in, on the next logged-in account, in the
# same window.
# Follows in-session /resume and /clear by watching Claude Code's live session
# record ($CLAUDE_CONFIG_DIR/sessions/<pid>.json) for this window's process.
# Auto-switch: once the account's session (5-hour) usage reaches
# TOKENBATON_SWITCH_AT percent (default 99) and Claude is idle, it is closed and
# the conversation resumes on the next account with room, without prompting.
# Set TOKENBATON_SWITCH_AT=0 to turn this off. Manual switch: /exit, Enter.
#   tokenbaton [N] [claude args...]   (N = starting profile; default: last used)
#   tokenbaton --pick                  print the account with the most room right now
set -uo pipefail
COUNT="${TOKENBATON_PROFILES:-5}"
SWITCH_AT="${TOKENBATON_SWITCH_AT:-99}"
POLL=60
CHECK="${TOKENBATON_CHECK_EVERY:-15}"   # seconds between the watcher's usage checks
BACKOFF=300   # after a failed usage check (e.g. HTTP 429), wait this long
LIVE=300      # status-line usage newer than this is used without asking the endpoint
ACC="${TOKENBATON_HOME:-$HOME/.tokenbaton}"
PROFILE_CMD="$(dirname "$(readlink -f "$0")")/tokenbaton-profile"
# Claude Code's status line gets the rate limits from every API response; this
# command saves them for usage() below (see tokenbaton-statusline).
STATUSLINE="$(dirname "$(readlink -f "$0")")/tokenbaton-statusline"
STATE="$ACC/current"
TRACK="$ACC/go.$$.session"
CUR="$ACC/go.$$.profile"
AUTO="$ACC/go.$$.auto"
STARTED_F="$ACC/go.$$.started"   # epoch ms of the newest claude process the watcher saw
SINCE_F="$ACC/go.$$.since"       # mtime marker for resolve_session's search bound
T0=${EPOCHSECONDS:-$(date +%s)}               # no transcript this window wrote can be older than this
TASKS_MSG="tokenbaton moved this conversation to another account because the last one \
reached its usage limit. Background tasks that were still running were stopped. \
Check how far they got, restart the ones still needed, and continue."
mkdir -p "$ACC"

# The watcher sleeps every second in every window; use bash's loadable sleep
# builtin when available so that doesn't fork/exec /usr/bin/sleep each time.
enable -f /usr/lib/bash/sleep sleep 2>/dev/null || true

# Drop per-window files left by windows that died without running their trap
# (killed, crashed, power loss), and status-line temp files from interrupted writes.
# Only a dead pid's files go: matching the command line deleted the live state of
# windows started under another name (e.g. a claude-go symlink), which turned
# their auto-switch off. A reused pid's leftovers are cleared by that window below.
for f in "$ACC"/go.*.*; do
  [[ -e "$f" ]] || continue
  pid="${f#"$ACC"/go.}"; pid="${pid%%.*}"
  [[ "$pid" =~ ^[0-9]+$ ]] || continue
  kill -0 "$pid" 2>/dev/null || [[ -d "/proc/$pid" ]] || rm -f "$f"
done
rm -f "$ACC"/go.$$.*
find "$ACC" -maxdepth 1 -name 'live.*.tmp' -mmin +10 -exec rm -f {} + 2>/dev/null
unset f pid

# Write $2 to state file $1, quietly: a full disk or a removed $ACC must not
# flood go.log. Recreates $ACC if it went away. Fails if the write didn't happen.
put() {
  { echo "$2" > "$1"; } 2>/dev/null && return 0
  mkdir -p "$ACC" 2>/dev/null && { echo "$2" > "$1"; } 2>/dev/null
}

# A profile is usable if it has a refresh token that hasn't expired. Read the
# file directly: `claude auth status` grabs the refresh lock on an expired
# access token and exits without releasing it, which then blocks every real
# session's auto-refresh ("another Claude Code process is refreshing it").
logged_in() {
  python3 -I - "$HOME/.claude-$1/.credentials.json" <<'PY' 2>/dev/null
import json, sys, time
o = json.load(open(sys.argv[1])).get("claudeAiOauth") or {}
exp = o.get("refreshTokenExpiresAt")
sys.exit(0 if o.get("refreshToken") and (not exp or exp / 1000 > time.time()) else 1)
PY
}

# Print a profile's usage percent from the usage endpoint, cached for $POLL
# seconds and shared by all windows. Prints nothing if unknown (e.g. the access token expired; Claude Code
# refreshes it on launch). Only one window fetches at a time; the rest reuse
# the cache. The cache holds "<percent> <fetched at>"; its mtime only schedules
# the next fetch. A failed fetch (e.g. HTTP 429) keeps the last value and waits
# $BACKOFF seconds, so windows sharing a rate-limited account don't keep hitting
# the endpoint. A value over 10 minutes old counts as unknown.
polled_usage() {
  local cache="$ACC/used.$1" lock="$ACC/used.$1.lock" v at
  if [[ -z "$(find "$cache" -maxdepth 0 -newermt "-$POLL seconds" 2>/dev/null)" ]] \
     && { mkdir "$lock" 2>/dev/null \
          || { [[ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]] \
               && rm -rf "$lock" && mkdir "$lock" 2>/dev/null; }; }; then
    python3 -I - "$HOME/.claude-$1/.credentials.json" "$cache" "$POLL" "$BACKOFF" <<'PY' 2>/dev/null
import json, os, sys, time, urllib.request
cache, poll, backoff = sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
now = time.time()
try:
    tok = json.load(open(sys.argv[1]))["claudeAiOauth"]["accessToken"]
    req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
        "Authorization": "Bearer " + tok, "anthropic-beta": "oauth-2025-04-20"})
    d = json.load(urllib.request.urlopen(req, timeout=15))
    # The 5-hour and 7-day meters, every row of limits[] that isn't tied to one
    # model, and the row the server itself headlines.
    pct = [(d.get(k) or {}).get("utilization") or 0 for k in ("five_hour", "seven_day")]
    pct += [r.get("percent") or 0 for r in d.get("limits") or []
            if r.get("is_active") or not ((r.get("scope") or {}).get("model"))]
    line, due = "%d %d\n" % (max(pct), now), now
except Exception:
    try: line = open(cache).read()
    except OSError: line = ""
    due = now + backoff - poll
tmp = "%s.%d.tmp" % (cache, os.getpid())
with open(tmp, "w") as f: f.write(line)
os.utime(tmp, (due, due))
os.replace(tmp, cache)
PY
    rmdir "$lock" 2>/dev/null
  fi
  read -r v at 2>/dev/null < "$cache" || return 0
  [[ "$v" =~ ^[0-9]+$ && "$at" =~ ^[0-9]+$ ]] && (( $(date +%s) - at < 600 )) && echo "$v"
}

# Print a profile's usage percent and when it was saved, from what the status
# line last saw on that account. A window whose reset time has passed counts as 0.
live_usage() {
  local p5 r5 p7 r7 at now u=0
  read -r p5 r5 p7 r7 at 2>/dev/null < "$ACC/live.$1" || return 1
  [[ "$p5$r5$p7$r7$at" =~ ^[0-9]+$ ]] || return 1
  now="$(date +%s)"
  (( r5 > now && p5 > u )) && u=$p5
  (( r7 > now && p7 > u )) && u=$p7
  echo "$u $at"
}

# Print a profile's usage percent: the status line's figure while a window on
# that account has used it in the last $LIVE seconds; otherwise the higher of
# that figure and the usage endpoint's (other machines and `claude -p` runs
# use the account without a status line).
usage() {
  local live at u
  read -r live at < <(live_usage "$1")
  if [[ -n "$live" ]] && (( $(date +%s) - at < LIVE )); then echo "$live"; return 0; fi
  u="$(polled_usage "$1")"
  if [[ -n "$live" && ( -z "$u" || "$live" -gt "${u:-0}" ) ]]; then echo "$live"; else echo "$u"; fi
}

has_room() {
  local u
  (( SWITCH_AT > 0 )) || return 0
  u="$(usage "$1")"
  [[ -z "$u" ]] || (( u < SWITCH_AT ))
}

# Remove ~/.claude-N.lock if it's over a minute old and no live process is
# running on that profile, so a crashed refresh can't block the next one.
clear_stale_lock() {
  local dir="$HOME/.claude-$1" lock="$HOME/.claude-$1.lock" p
  [[ -d "$lock" ]] || return 0
  [[ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]] || return 0
  for p in /proc/[0-9]*/environ; do
    grep -qzx "CLAUDE_CONFIG_DIR=$dir" "$p" 2>/dev/null && return 0
  done
  rmdir "$lock" 2>/dev/null && echo "tokenbaton: cleared stale refresh lock for profile $1" >&2
}

launch() {
  clear_stale_lock "$1"
  put "$CUR" "$1"
  "$PROFILE_CMD" "$1" --settings "{\"statusLine\":{\"type\":\"command\",\"command\":\"TOKENBATON_HOME='$ACC' '$STATUSLINE'\"}}" "${@:2}"
}

# Next logged-in profile after $1 with usage below the switch threshold.
# Accounts are used one at a time: prefer the one the other windows moved to
# (the shared last-used profile), so windows don't drift onto different
# accounts and drain several at once.
next_profile() {
  local cur="$1" i n
  n="$(cat "$STATE" 2>/dev/null)"
  if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= COUNT && n != cur )) \
     && logged_in "$n" && has_room "$n"; then
    echo "$n"; return 0
  fi
  for (( i = 1; i < COUNT; i++ )); do
    n=$(( (cur + i - 1) % COUNT + 1 ))
    if logged_in "$n" && has_room "$n"; then echo "$n"; return 0; fi
  done
  return 1
}

# Map an ID to a saved conversation. If no transcript has that name (the window
# was launched with an ID, then moved to another chat via /resume), use the
# newest transcript whose entries were written by a process with that ID.
# $2 (optional) is the start time (epoch ms) of the Claude process: a transcript
# that process wrote was modified after it started, so only those are searched
# (the projects tree is many GB). Without it, the start of this claude-go run
# is the bound, since every process it launched started after that.
resolve_session() {
  local id="$1" since="${2:-}" f
  [[ -n "$id" ]] || return 1
  for f in "$HOME"/.claude/projects/*/"$id".jsonl; do
    [[ -e "$f" ]] && { echo "$id"; return 0; }
  done
  [[ "$since" =~ ^[0-9]+$ ]] && since=$(( since / 1000 )) || since=$T0
  # `find -newer` a marker file stamped with the bound (portable; -newermt is GNU-only).
  touch -t "$(printf '%(%Y%m%d%H%M.%S)T' "$(( since - 5 ))")" "$SINCE_F" 2>/dev/null || return 1
  f="$(find -H "$HOME/.claude/projects" -name '*.jsonl' -not -path '*/subagents/*' \
         -newer "$SINCE_F" -print0 2>/dev/null \
       | xargs -0 -r grep -l -F "\"session_id\":\"$id\"" 2>/dev/null \
       | xargs -r ls -t 2>/dev/null | head -1)"
  [[ -n "$f" ]] || return 1
  f="${f##*/}"; echo "${f%.jsonl}"
}

# True if Claude's last reply in the conversation was a usage-limit error.
# Look at assistant entries only: background-task notifications can queue up
# as user entries after the error, and they're still unanswered.
hit_limit() {
  local f
  f="$(ls -t "$HOME"/.claude/projects/*/"$1".jsonl 2>/dev/null | head -1)"
  [[ -n "$f" ]] && tail -n 300 "$f" | grep -a '"type":"assistant"' | tail -1 \
    | grep -q '"error":"rate_limit"'
}

# True if conversation $1 was refused for a usage limit by the Claude process
# that started at $2 (epoch ms), and that limit hasn't reset yet. Used when the
# usage endpoint itself is rate-limited (HTTP 429) and can't say the account is
# full. The start-time check skips an error left over from an earlier account.
limited_since() {
  local f
  f="$(ls -t "$HOME"/.claude/projects/*/"$1".jsonl 2>/dev/null | head -1)"
  [[ -n "$f" && -n "$2" ]] || return 1
  local last
  last="$(tail -n 300 "$f" | grep -a '"type":"assistant"' | tail -1)"
  [[ "$last" == *'"error":"rate_limit"'* ]] || return 1   # skip python unless it can match
  printf '%s\n' "$last" | python3 -I -c '
import json, sys, time
from datetime import datetime
e = json.loads(sys.stdin.read())
assert e.get("error") == "rate_limit"
ts = datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).timestamp()
reset = (e.get("quotaLimits") or {}).get("resetsAt")
assert ts * 1000 >= int(sys.argv[1]) and (not reset or reset > time.time())
' "$2" 2>/dev/null
}

# Record the sessionId of whichever claude process is our direct child, and
# leave its pid, start time (epoch ms), status ("idle", "busy", ...), profile
# and session in $child / $started / $status / $child_profile / $last_sid.
# The profile comes from the folder the session record is in, so it is known
# even when $CUR is missing. $TRACK and $STARTED_F are written again if they
# disappear (another process removed them, or a write failed on a full disk).
snapshot() {
  local f pid sid st c
  child=""; status=""; started=""; child_profile=""
  for f in "$HOME"/.claude-[0-9]*/sessions/*.json; do
    [[ -e "$f" ]] || continue
    pid="${f##*/}"; pid="${pid%.json}"
    # Parent pid from /proc without forking (the 4th stat field, after "(comm) state");
    # ps where there is no /proc (macOS).
    if [[ -d /proc/self ]]; then
      read -r st 2>/dev/null < "/proc/$pid/stat" || continue
      st="${st##*) }"; st="${st#* }"; st="${st%% *}"
    else
      st="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    fi
    [[ "$st" == "$$" ]] || continue
    { c="$(< "$f")"; } 2>/dev/null || continue
    sid=""
    [[ "$c" =~ \"sessionId\":\"([^\"]*)\" ]] && sid="${BASH_REMATCH[1]}"
    if [[ -n "$sid" && ( "$sid" != "$last_sid" || ! -s "$TRACK" ) ]]; then
      put "$TRACK" "$sid"; last_sid="$sid"
    fi
    child="$pid"
    child_profile="${f%/sessions/*}"; child_profile="${child_profile##*/.claude-}"
    [[ "$child_profile" =~ ^[0-9]+$ ]] || child_profile=""
    started=""; [[ "$c" =~ \"startedAt\":([0-9]*) ]] && started="${BASH_REMATCH[1]}"
    status=""; [[ "$c" =~ \"status\":\"([^\"]*)\" ]] && status="${BASH_REMATCH[1]}"
  done
  if [[ -n "$started" && ( "$started" != "$last_started" || ! -s "$STARTED_F" ) ]]; then
    put "$STARTED_F" "$started"; last_started="$started"
  fi
}

# Close an idle Claude whose account is at the threshold, if another account
# has room; the main loop then resumes the conversation there.
# Claude Code reports "shell" instead of "idle" while background Bash tasks are
# running (e.g. `claude -p` workers). Those are stopped too, so nothing keeps
# running that the resumed conversation can't track; it is asked to restart them.
# No state file is required: the profile and session come from snapshot when
# $CUR / $TRACK are gone, and the main window is told by signal (USR1 idle,
# USR2 shell) as well as through $AUTO, so a failed write still switches.
maybe_switch() {
  local p u sid
  (( SWITCH_AT > 0 )) && [[ -n "$child" && ! -e "$AUTO" ]] || return 0
  [[ "$status" == idle || "$status" == shell ]] || return 0
  p="$child_profile"; [[ -n "$p" ]] || p="$(cat "$CUR" 2>/dev/null)"
  [[ "$p" =~ ^[0-9]+$ ]] || return 0
  u="$(usage "$p")"
  if [[ -z "$u" ]] || (( u < SWITCH_AT )); then
    sid="$(cat "$TRACK" 2>/dev/null)"; sid="${sid:-$last_sid}"
    limited_since "$(resolve_session "$sid" "$started")" "$started" || return 0
    u=100
  fi
  next_profile "$p" > /dev/null || return 0
  # The usage checks above can take seconds; don't kill a turn that began meanwhile.
  local c="$child" s="$status"; snapshot
  [[ "$child" == "$c" && "$status" == "$s" ]] || return 0
  put "$AUTO" "$p $u $status" || echo "tokenbaton: could not write $AUTO; signalling instead" >&2
  if [[ "$status" == shell ]]; then kill -USR2 "$$"; else kill -USR1 "$$"; fi
  stop_tree "$child"
}

# Print every process descended from $1.
descendants() {
  ps -e -o pid= -o ppid= | awk -v root="$1" '
    { kids[$2] = kids[$2] " " $1 }
    END { q = root; while (q != "") { split(q, a, " "); q = ""
            for (i in a) { n = split(kids[a[i]], k, " ")
              for (j = 1; j <= n; j++) { print k[j]; q = q " " k[j] } } } }'
}

# Stop Claude ($1) normally, then anything it had started that outlived it
# (background tasks can sit in their own process groups and sessions).
stop_tree() {
  local tree i
  tree="$(descendants "$1")"
  kill -TERM "$1" 2>/dev/null
  for (( i = 0; i < 20; i++ )); do kill -0 "$1" 2>/dev/null || break; sleep 0.5; done
  [[ -n "$tree" ]] || return 0
  kill -TERM $tree 2>/dev/null
  for (( i = 0; i < 10; i++ )); do kill -0 $tree 2>/dev/null || return 0; sleep 0.5; done
  kill -KILL $tree 2>/dev/null
}

watch() {
  local t=0 last_sid="" last_started="" child_profile=""
  while kill -0 "$$" 2>/dev/null; do
    snapshot
    (( t++ % CHECK == 0 )) && maybe_switch
    sleep 1
  done
}

# The watcher shares the terminal with Claude Code's full-screen UI, so it
# must never print there; anything it says goes to a log instead.
watch > /dev/null 2>> "$ACC/go.log" &
watcher=$!
trap 'kill "$watcher" 2>/dev/null; rm -f "$TRACK" "$CUR" "$AUTO" "$STARTED_F" "$SINCE_F"' EXIT
# The watcher's auto-switch notice, for when it couldn't write $AUTO.
signalled=""
trap 'signalled=idle' USR1
trap 'signalled=shell' USR2

profile="$(cat "$STATE" 2>/dev/null || echo 1)"
# --pick: print the logged-in profile with the most room (lowest usage below the
# switch threshold) and exit. Headless runs use it through tokenbaton-exec.
if [[ "${1:-}" == "--pick" ]]; then
  best="" best_u=101
  for (( n = 1; n <= COUNT; n++ )); do
    logged_in "$n" && has_room "$n" || continue
    u="$(usage "$n")"; u="${u:-0}"
    if (( u < best_u )); then best="$n"; best_u="$u"; fi
  done
  [[ -n "$best" ]] || { echo "tokenbaton: no logged-in account has room" >&2; exit 1; }
  echo "$best"
  exit 0
fi

if [[ "${1:-}" =~ ^[0-9]+$ ]] && (( $1 >= 1 && $1 <= COUNT )); then profile="$1"; shift; fi
[[ "$profile" =~ ^[0-9]+$ ]] && (( profile >= 1 && profile <= COUNT )) || profile=1

# Start pinned to a fresh ID unless the caller already chose a session.
case " $* " in
  *" -c "*|*" --continue "*|*" -r "*|*" --resume"*|*" --session-id"*)
    launch "$profile" "$@" ;;
  *)
    sid="$(cat /proc/sys/kernel/random/uuid)"
    put "$TRACK" "$sid"
    launch "$profile" --session-id "$sid" "$@" ;;
esac

# The conversation last resumed, for when $TRACK is missing.
known="${sid:-}"
while true; do
  tracked="$(cat "$TRACK" 2>/dev/null || true)"; tracked="${tracked:-$known}"
  session=""
  [[ -n "$tracked" ]] && session="$(resolve_session "$tracked" "$(cat "$STARTED_F" 2>/dev/null)" || true)"
  echo >&2
  auto=""; was=""; p=""; u=""
  if [[ -e "$AUTO" || -n "$signalled" ]]; then
    auto=1; read -r p u was 2>/dev/null < "$AUTO"; rm -f "$AUTO"
    was="${was:-$signalled}"; signalled=""
    if [[ -n "$u" ]]; then u="${u}% usage"; else u="its usage limit"; fi
    echo "tokenbaton: account ${p:-$profile} is at $u; switching ${session:0:8} automatically" >&2
  else
    read -r -p "tokenbaton: [Enter] continue ${session:0:8} on next account, q to quit: " ans || break
    [[ "$ans" == q* ]] && break
  fi
  if ! next="$(next_profile "$profile")"; then
    echo "tokenbaton: no other logged-in profile with usage below ${SWITCH_AT}%" >&2
    continue
  fi
  profile="$next"
  [[ -n "$session" ]] && known="$session"
  if [[ -n "$session" && "$was" == shell ]]; then
    launch "$profile" --resume "$session" "$TASKS_MSG"
  elif [[ -n "$session" && -n "$auto" ]] && hit_limit "$session"; then
    launch "$profile" --resume "$session" "continue"
  elif [[ -n "$session" ]]; then
    launch "$profile" --resume "$session"
  elif [[ -n "$auto" ]]; then
    # Nothing was said yet, so there's no transcript; --continue would grab
    # some other conversation in this directory. Start fresh instead.
    launch "$profile"
  else
    launch "$profile" --continue
  fi
done
